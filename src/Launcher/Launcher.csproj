<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10/11, so the exe runs without installing anything -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AlyxMP</AssemblyName>
    <RootNamespace>AlyxMP</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\alyxmp.ico</ApplicationIcon>
    <Version>0.5.3</Version>
    <Product>Alyx Multiplayer</Product>
    <Description>Alyx Multiplayer launcher</Description>
    <Copyright>Fan-made mod, not affiliated with Valve</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Common\*.cs" Link="Common\%(Filename)%(Extension)" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
